node_modules/
dist/
.DS_Store

# Desktop build output
release/

# scratch GLB rigging diagnostics (local only)
/_*.mjs

# web distribution output (tools/dist.mjs)
dist-web/

# portable mech exports (tools/export-mech.mjs) — 214MB of DERIVED files.
# Regenerate with `node tools/export-mech.mjs --all`; nothing in the game
# reads them, and they are re-derivable from the model + the manifest.
public/models/export/

# dry-run bake output (tools/bake-glb.mjs) — never committed
public/models/*.baked.glb

# session scratch: underscore-prefixed probe folders under public/models (served by
# the dev server for A/B harnesses) and *.tmp.* harness scripts in tools/scratch
public/models/_*/
tools/scratch/_*.tmp.*
